# Copy this file to .env.local and fill in the values you have.
#
# The site works with NONE of these set — it runs in a self-contained demo
# mode using the seed data in src/lib/seed-data.ts and an in-memory order
# store, so you can `npm run dev` immediately with no accounts. Add the
# Supabase and Stripe variables below when you're ready to connect a real
# database and take real payments. See README.md for full setup steps.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose this to the browser or commit
# it. Used for orders/webhooks/admin writes that bypass RLS on purpose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ------------------------------------------------------------------
# Dashboard -> Developers -> API keys (use test keys while developing).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks (or from `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=

# --- Email (optional, for order/receipt notifications) ---------------------
RESEND_API_KEY=

# --- Maps (optional) --------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Maps Embed API.
# Without this, the Contact page shows a location card instead of a live map
# (never a broken/blank embed).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Site --------------------------------------------------------------------
# Used to build absolute URLs (metadata, sitemap, Stripe return_url).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
