# Betfair certificate login — see https://developer.betfair.com/
BETFAIR_USERNAME=your-betfair-username
BETFAIR_PASSWORD=your-betfair-password
BETFAIR_APP_KEY=your-betfair-app-key
BETFAIR_CERT_PATH=/path/to/client-2048.crt
BETFAIR_CERT_KEY_PATH=/path/to/client-2048.key

# Live football data provider (provider TBD — see data/football_feed.py)
FOOTBALL_DATA_API_KEY=your-football-data-api-key

# Optional: external odds/consensus provider (football Strategy 7)
EXTERNAL_ODDS_API_KEY=your-external-odds-api-key

# Defaults to betfair_trading/var/trading.duckdb if unset
TRADING_DB_PATH=

# PAPER (default) / SHADOW / LIVE
TRADING_MODE=PAPER

# Must be exactly YES, together with TRADING_MODE=LIVE, before any real
# order can be placed. Leave unset/blank for PAPER and SHADOW.
LIVE_TRADING_CONFIRMED=
